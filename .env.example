# Copy to .env and adjust. Every variable is optional; the defaults run fully locally.
# Never commit .env - it is git-ignored.

# --- storage ---------------------------------------------------------------------
# Default: SQLite at data/aegis.db. Docker Compose sets a PostgreSQL/PostGIS URL itself.
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis:password@localhost:5432/aegis
# AEGIS_DATA_DIR=./data
# AEGIS_DB_PASSWORD=change-me            # used by docker-compose for the PostGIS container

# --- security --------------------------------------------------------------------
# Enable bearer-token authentication for all mutating endpoints (recommended when shared).
# AEGIS_AUTH_ENABLED=true
# Format: token=user:role;token2=user2:role2  (roles: viewer, analyst, admin)
# AEGIS_API_TOKENS=replace-with-a-long-random-token=alice:admin;another-token=bob:analyst
# AEGIS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# AEGIS_RATE_LIMIT_PER_MINUTE=240

# --- processing ------------------------------------------------------------------
# AEGIS_TORCH_DEVICE=auto                # auto | cpu | cuda
# AEGIS_WORKER_THREADS=2                 # concurrent analysis runs
# AEGIS_MAX_AOI_KM2=1500
# AEGIS_DEFAULT_RESOLUTION_M=20
# AEGIS_MODEL_VARIANT=auto               # auto = validation-selected model (models/selection.json)
# AEGIS_SAR_SPECIALIST=auto              # "" disables the SAR specialist hybrid

# --- data sources ----------------------------------------------------------------
# AEGIS_OFFLINE=false                    # true: never touch the network, cached data only
# Free key for historical NASA FIRMS active-fire queries: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# AEGIS_FIRMS_MAP_KEY=

# --- optional LLM narrative (Claude) -----------------------------------------------
# When set, executive summaries may be drafted by Claude from verified facts; drafts that fail
# the numeric/citation grounding check are discarded in favour of the deterministic template.
# AEGIS_ANTHROPIC_API_KEY=
# AEGIS_LLM_MODEL=claude-opus-5-5

# --- outbound alerts -------------------------------------------------------------
# Approved (human-signed-off) real-data alerts are POSTed here as JSON. Unset = internal only.
# AEGIS_ALERT_WEBHOOK_URL=
