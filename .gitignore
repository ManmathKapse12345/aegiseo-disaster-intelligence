# runtime data, caches, downloaded datasets, databases, generated artefacts
# (anchored to the repository root: an unanchored "data/" also ignored frontend/src/data/, which the UI imports)
/data/
*.db
*.db-wal
*.db-shm

# python
**/.venv/
**/__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# node / frontend
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/*.tmp.mjs

# logs and local configuration
*.log
models/evaluation_log.txt
.env
.env.*
!.env.example

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated submission bundle (docs/deliverables/source/prepare_submission.py)
docs/deliverables/submission/
